{
  "name": "absolute-crm-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Node.js + Express + MongoDB REST API for the Odoo CRM (Absolute Concepts Events & Entertainment).",
  "scripts": {
    "dev":   "nodemon src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "nodemonConfig": {
    "watch": ["src", ".env"],
    "ext":   "js,json",
    "ignore": ["node_modules"],
    "delay": 200
  }
}
